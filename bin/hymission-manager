#!/usr/bin/env python3
"""Install and configure hymission's compositor-side live overview."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import urllib.request

RELEASES = {
    "0.56.0": {
        "version": "0.5.0",
        "tag": "v0.5.0-v0.56.0",
        "sha256": "5c5a048277b896d4348c7e6dac7acec5e9d51cbae94102fcedbf26bd7f06d81d",
    },
    "0.56.2": {
        "version": "0.8.0",
        "tag": "v0.8.0-v0.56.2",
        "sha256": "1c4be0fe85d072f39bf1f568a5ca9c9dfe60207f05ecc1b4acf4d3e63998e5a8",
    },
}


def paths():
    home = Path.home()
    config = Path(os.environ.get("HYMISSION_CONFIG", home / ".config/hypr/hymission.lua"))
    hyprland = Path(os.environ.get("HYMISSION_HYPRLAND_CONFIG", home / ".config/hypr/hyprland.lua"))
    library = Path(os.environ.get("HYMISSION_LIBRARY", home / ".local/lib/hymission.so"))
    helper = Path(os.environ.get("HYMISSION_SEARCH_HELPER", home / ".local/bin/hymission-search-input"))
    cache = Path(os.environ.get("HYMISSION_CACHE", home / ".cache/omarchy-control-panel/hymission"))
    return config, hyprland, library, helper, cache


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def ensure_require(path):
    marker = 'require("hypr.hymission")'
    text = path.read_text(encoding="utf-8") if path.exists() else ""
    if marker in text:
        return False
    if text and not text.endswith("\n"):
        text += "\n"
    atomic_write(path, text + "\n-- Omarchy Control Panel Hymission\n" + marker + "\n")
    return True


def render_config(enabled, animated, library):
    if not enabled:
        return """-- Generated by Omarchy Control Panel. Safe to delete.
-- Hymission is disabled.
if hl.plugin and hl.plugin.hymission then
  pcall(function() hl.plugin.hymission.close() end)
end
hl.unbind("SUPER + SHIFT + UP")
"""
    duration = 140 if animated else 0
    bar_animation = 1 if animated else 0
    return f'''-- Generated by Omarchy Control Panel. Safe to delete.
local hymission_library = {json.dumps(str(library))}
hl.exec_cmd("hyprctl plugin load " .. hymission_library)
if hl.plugin and hl.plugin.hymission then
  hl.config({{
    plugin = {{
      hymission = {{
        only_active_workspace = 0,
        only_active_monitor = 0,
        workspace_change_keeps_overview = 0,
        hover_relayout_duration = {duration},
        hide_bar_animation = {bar_animation},
      }},
    }},
  }})
  hl.unbind("SUPER + SHIFT + UP")
  hl.bind("SUPER + SHIFT + UP", function()
    hl.plugin.hymission.toggle("forceall")
  end, {{ description = "Hymission" }})
  hl.plugin.hymission.gesture({{
    fingers = 3,
    direction = "up",
    action = "open",
    args = "forceall",
  }})
end
'''


def current_hyprland_version():
    try:
        result = subprocess.run(["hyprctl", "version"], text=True, capture_output=True, check=False)
        for token in result.stdout.split():
            if token[0:1].isdigit() and token.count(".") >= 2:
                return token.split("-")[0]
    except OSError:
        pass
    return ""


def release_for_version(version):
    # Hymission is loaded inside Hyprland, so select the matching ABI release.
    return RELEASES.get(version)


def install(library, helper, cache):
    version = current_hyprland_version()
    release = release_for_version(version or "0.56.0")
    if not release:
        supported = ", ".join(sorted(RELEASES))
        raise RuntimeError(f"Hymission has no ABI-matched release for Hyprland {version}; supported: {supported}")
    tag = release["tag"]
    marker = cache / "installed-release.json"
    if library.exists() and helper.exists() and marker.exists():
        try:
            if json.loads(marker.read_text(encoding="utf-8")).get("tag") == tag:
                return False
        except (OSError, ValueError):
            pass
    archive = cache / f"hymission-{tag}.tar.gz"
    source = cache / f"hymission-{tag}"
    build = source / "build-cmake"
    cache.mkdir(parents=True, exist_ok=True)
    if not archive.exists():
        source_url = f"https://github.com/gfhdhytghd/hymission/archive/refs/tags/{tag}.tar.gz"
        with urllib.request.urlopen(source_url, timeout=60) as response:
            archive.write_bytes(response.read())
    digest = hashlib.sha256(archive.read_bytes()).hexdigest()
    if digest != release["sha256"]:
        archive.unlink(missing_ok=True)
        raise RuntimeError("Hymission source checksum mismatch")
    if source.exists():
        shutil.rmtree(source)
    source.mkdir(parents=True)
    subprocess.run(["tar", "-xzf", str(archive), "--strip-components=1", "-C", str(source)], check=True)
    subprocess.run(["cmake", "-S", str(source), "-B", str(build), "-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=ON"], check=True)
    subprocess.run(["cmake", "--build", str(build), "-j2"], check=True)
    subprocess.run(["ctest", "--test-dir", str(build), "--output-on-failure"], check=True)
    library.parent.mkdir(parents=True, exist_ok=True)
    helper.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(build / "libhymission.so", library)
    shutil.copy2(build / "hymission-search-input", helper)
    library.chmod(0o755)
    helper.chmod(0o755)
    atomic_write(marker, json.dumps({"tag": tag, "hyprland": version}, sort_keys=True) + "\n")
    return True


def live_reload(enabled, library):
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    if not enabled and library.exists():
        subprocess.run(["hyprctl", "plugin", "unload", str(library)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["hyprctl", "reload"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def state():
    config, _, library, helper, _ = paths()
    text = config.read_text(encoding="utf-8") if config.exists() else ""
    return {
        "ok": True,
        "enabled": "hl.plugin.hymission.toggle" in text,
        "installed": library.exists() and helper.exists(),
        "version": "selected at enable time",
        "hyprland": current_hyprland_version(),
    }


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("status", "enable", "disable", "sync"))
    parser.add_argument("--animated", choices=("true", "false"), default="false")
    parser.add_argument("--no-live", action="store_true")
    args = parser.parse_args(argv)
    config, hyprland, library, helper, cache = paths()
    try:
        if args.action == "status":
            print(json.dumps(state()))
            return 0
        enabled = args.action != "disable"
        if enabled and args.action == "enable":
            install(library, helper, cache)
        if enabled and not library.exists():
            raise RuntimeError("Hymission is not installed")
        ensure_require(hyprland)
        atomic_write(config, render_config(enabled, args.animated == "true", library))
        if not args.no_live:
            live_reload(enabled, library)
        result = state()
        result["animated"] = args.animated == "true"
        print(json.dumps(result))
        return 0
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(json.dumps({"ok": False, "error": str(error)}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
