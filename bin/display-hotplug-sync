#!/usr/bin/env python3
"""Reapply the active profile's display map after monitor hotplug."""

import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys


def load_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def display_topology(current):
    identities = [str(row.get("fingerprint") or row.get("name") or "")
                  for row in current if not row.get("disabled")]
    return "::".join(sorted(identity for identity in identities if identity))


def active_display_map(profiles, current=None):
    active_id = profiles.get("activeProfileId")
    for profile in profiles.get("profiles", []):
        if profile.get("id") == active_id:
            settings = profile.get("settings", {})
            layouts = settings.get("displayLayouts")
            topology = display_topology(current or [])
            if isinstance(layouts, dict) and topology and isinstance(layouts.get(topology), dict):
                return layouts[topology]
            displays = settings.get("displays")
            return displays if isinstance(displays, dict) else {}
    return {}


def merge_layout(current, active_names, saved):
    result = []
    for display in current:
        name = display.get("name")
        if name not in active_names:
            continue
        wanted = saved.get(display.get("fingerprint")) or saved.get(name)
        if not isinstance(wanted, dict):
            result.append(display)
            continue
        merged = dict(display)
        for key in ("scale", "mode", "x", "y", "transform", "mirror"):
            if key in wanted:
                merged[key] = wanted[key]
        merged["disabled"] = False
        result.append(merged)
    return result


def run_json(command):
    completed = subprocess.run(command, text=True, capture_output=True, timeout=20, check=True)
    return json.loads(completed.stdout)


def main():
    home = Path.home()
    profiles_path = Path(os.environ.get(
        "OMARCHY_CONTROL_PANEL_PROFILES",
        home / ".local/state/omarchy/control-panel-profiles.json",
    ))
    display_manager = Path(__file__).resolve().with_name("display-manager")
    lock_path = home / ".local/state/omarchy/control-panel-display-hotplug.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)

    try:
        with lock_path.open("w", encoding="utf-8") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            current = run_json([str(display_manager), "state"])
            saved = active_display_map(load_json(profiles_path), current)
            if not saved:
                print(json.dumps({"ok": True, "changed": False, "reason": "no active profile display map"}))
                return 0

            active = run_json(["hyprctl", "-j", "monitors"])
            active_names = {row.get("name") for row in active if row.get("name")}
            wanted = merge_layout(current, active_names, saved)
            if not wanted:
                print(json.dumps({"ok": True, "changed": False, "reason": "no active displays"}))
                return 0

            comparable = ("name", "scale", "mode", "x", "y", "transform", "mirror", "disabled")
            before = [{key: row.get(key) for key in comparable} for row in current if row.get("name") in active_names]
            after = [{key: row.get(key) for key in comparable} for row in wanted]
            if before == after:
                print(json.dumps({"ok": True, "changed": False}))
                return 0

            subprocess.run(
                [str(display_manager), "apply", json.dumps(wanted, separators=(",", ":"))],
                text=True,
                capture_output=True,
                timeout=45,
                check=True,
            )
            print(json.dumps({"ok": True, "changed": True, "monitors": sorted(active_names)}))
            return 0
    except BlockingIOError:
        print(json.dumps({"ok": True, "changed": False, "reason": "already running"}))
        return 0
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(json.dumps({"ok": False, "error": str(error)}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
