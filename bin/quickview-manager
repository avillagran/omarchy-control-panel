#!/usr/bin/env python3
"""Install and configure QuickView's compositor-side live overview."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import urllib.request

VERSION = "0.7.1"
HYPRLAND_VERSION = "0.56.2"
TAG = f"v{VERSION}-v{HYPRLAND_VERSION}"
SOURCE_URL = f"https://github.com/gfhdhytghd/hymission/archive/refs/tags/{TAG}.tar.gz"
SOURCE_SHA256 = "67454160f1e67dcb1edb1eb5930af68d70538e6202511f32ded88a032434f679"


def paths():
    home = Path.home()
    config = Path(os.environ.get("QUICKVIEW_CONFIG", home / ".config/hypr/control-panel-quickview.lua"))
    hyprland = Path(os.environ.get("QUICKVIEW_HYPRLAND_CONFIG", home / ".config/hypr/hyprland.lua"))
    library = Path(os.environ.get("QUICKVIEW_LIBRARY", home / ".local/lib/omarchy-control-panel/libhymission.so"))
    helper = Path(os.environ.get("QUICKVIEW_SEARCH_HELPER", home / ".local/bin/hymission-search-input"))
    cache = Path(os.environ.get("QUICKVIEW_CACHE", home / ".cache/omarchy-control-panel/hymission"))
    return config, hyprland, library, helper, cache


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def ensure_require(path):
    marker = 'require("hypr.control-panel-quickview")'
    text = path.read_text(encoding="utf-8") if path.exists() else ""
    if marker in text:
        return False
    if text and not text.endswith("\n"):
        text += "\n"
    atomic_write(path, text + "\n-- Omarchy Control Panel QuickView\n" + marker + "\n")
    return True


def render_config(enabled, animated, library):
    if not enabled:
        return """-- Generated by Omarchy Control Panel. Safe to delete.
-- QuickView is disabled.
if hl.plugin and hl.plugin.hymission then
  pcall(function() hl.plugin.hymission.close() end)
end
hl.unbind("SUPER + SHIFT + UP")
"""
    duration = 140 if animated else 0
    bar_animation = 1 if animated else 0
    return f'''-- Generated by Omarchy Control Panel. Safe to delete.
local quickview_library = {json.dumps(str(library))}
hl.exec_cmd("hyprctl plugin load " .. quickview_library)
if hl.plugin and hl.plugin.hymission then
  hl.config({{
    plugin = {{
      hymission = {{
        only_active_workspace = 0,
        only_active_monitor = 0,
        workspace_change_keeps_overview = 0,
        hover_relayout_duration = {duration},
        hide_bar_animation = {bar_animation},
      }},
    }},
  }})
  hl.unbind("SUPER + SHIFT + UP")
  hl.bind("SUPER + SHIFT + UP", function()
    hl.plugin.hymission.toggle("forceall")
  end, {{ description = "QuickView" }})
  hl.plugin.hymission.gesture({{
    fingers = 3,
    direction = "up",
    action = "open",
    args = "forceall",
  }})
end
'''


def current_hyprland_version():
    try:
        result = subprocess.run(["hyprctl", "version"], text=True, capture_output=True, check=False)
        for token in result.stdout.split():
            if token[0:1].isdigit() and token.count(".") >= 2:
                return token.split("-")[0]
    except OSError:
        pass
    return ""


def install(library, helper, cache):
    if library.exists() and helper.exists():
        return False
    version = current_hyprland_version()
    if version and version != HYPRLAND_VERSION:
        raise RuntimeError(f"QuickView {VERSION} requires Hyprland {HYPRLAND_VERSION}; found {version}")
    archive = cache / f"hymission-{TAG}.tar.gz"
    source = cache / f"hymission-{TAG}"
    build = source / "build-cmake"
    cache.mkdir(parents=True, exist_ok=True)
    if not archive.exists():
        with urllib.request.urlopen(SOURCE_URL, timeout=60) as response:
            archive.write_bytes(response.read())
    digest = hashlib.sha256(archive.read_bytes()).hexdigest()
    if digest != SOURCE_SHA256:
        archive.unlink(missing_ok=True)
        raise RuntimeError("QuickView source checksum mismatch")
    if source.exists():
        shutil.rmtree(source)
    source.mkdir(parents=True)
    subprocess.run(["tar", "-xzf", str(archive), "--strip-components=1", "-C", str(source)], check=True)
    subprocess.run(["cmake", "-S", str(source), "-B", str(build), "-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=ON"], check=True)
    subprocess.run(["cmake", "--build", str(build), "-j2"], check=True)
    subprocess.run(["ctest", "--test-dir", str(build), "--output-on-failure"], check=True)
    library.parent.mkdir(parents=True, exist_ok=True)
    helper.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(build / "libhymission.so", library)
    shutil.copy2(build / "hymission-search-input", helper)
    library.chmod(0o755)
    helper.chmod(0o755)
    return True


def live_reload(enabled, library):
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    if not enabled and library.exists():
        subprocess.run(["hyprctl", "plugin", "unload", str(library)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["hyprctl", "reload"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def state():
    config, _, library, helper, _ = paths()
    text = config.read_text(encoding="utf-8") if config.exists() else ""
    return {
        "ok": True,
        "enabled": "hl.plugin.hymission.toggle" in text,
        "installed": library.exists() and helper.exists(),
        "version": VERSION,
        "hyprland": HYPRLAND_VERSION,
    }


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("status", "enable", "disable", "sync"))
    parser.add_argument("--animated", choices=("true", "false"), default="false")
    parser.add_argument("--no-live", action="store_true")
    args = parser.parse_args(argv)
    config, hyprland, library, helper, cache = paths()
    try:
        if args.action == "status":
            print(json.dumps(state()))
            return 0
        enabled = args.action != "disable"
        if enabled and args.action == "enable":
            install(library, helper, cache)
        if enabled and not library.exists():
            raise RuntimeError("QuickView is not installed")
        ensure_require(hyprland)
        atomic_write(config, render_config(enabled, args.animated == "true", library))
        if not args.no_live:
            live_reload(enabled, library)
        result = state()
        result["animated"] = args.animated == "true"
        print(json.dumps(result))
        return 0
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(json.dumps({"ok": False, "error": str(error)}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
