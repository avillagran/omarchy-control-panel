From 3f73d000d061fd68ad806289950bdc2088009ddf Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9s=20Villagr=C3=A1n?= <avillagran@omarchy.local>
Date: Sun, 13 Sep 2026 19:12:10 -0300
Subject: [PATCH 3/6] config: drop input refresh from scroll accel options

Values are read per scroll event at runtime, so reinitializing input
devices on every change is unnecessary and causes hitches when sliders
are dragged.
---
 src/config/values/ConfigValues.cpp | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/src/config/values/ConfigValues.cpp b/src/config/values/ConfigValues.cpp
index 40f2a83e..831d331d 100644
--- a/src/config/values/ConfigValues.cpp
+++ b/src/config/values/ConfigValues.cpp
@@ -405,12 +405,10 @@ std::vector<SP<IValue>> Values::getConfigValues() {
         MS<Bool>("input:touchpad:natural_scroll", "Inverts scrolling direction.", false, {.refresh = Supplementary::REFRESH_INPUT_DEVICES}),
         MS<Float>("input:touchpad:scroll_factor", "Multiplier applied to the amount of scroll movement.", 1,
                   {.min = 0, .max = 100, .refresh = Supplementary::REFRESH_INPUT_DEVICES}),
-        MS<Int>("input:touchpad:scroll_accel_profile", "Scroll acceleration profile for touchpads. [0=off, 1=linear, 2=adaptive]", 1,
-                {.min = 0, .max = 2, .refresh = Supplementary::REFRESH_INPUT_DEVICES}),
-        MS<Float>("input:touchpad:scroll_accel_speed", "Speed threshold (px/ms) at which scroll acceleration reaches maximum.", 1.0,
-                  {.min = 0.1, .max = 5, .refresh = Supplementary::REFRESH_INPUT_DEVICES}),
-        MS<Float>("input:touchpad:scroll_accel_max", "Maximum scroll acceleration multiplier.", 3.0, {.min = 1, .max = 10, .refresh = Supplementary::REFRESH_INPUT_DEVICES}),
-        MS<Float>("input:touchpad:scroll_decel", "Deceleration time (ms) for scroll inertia.", 150, {.min = 0, .max = 1000, .refresh = Supplementary::REFRESH_INPUT_DEVICES}),
+        MS<Int>("input:touchpad:scroll_accel_profile", "Scroll acceleration profile for touchpads. [0=off, 1=linear, 2=adaptive]", 1, {.min = 0, .max = 2}),
+        MS<Float>("input:touchpad:scroll_accel_speed", "Speed threshold (px/ms) at which scroll acceleration reaches maximum.", 1.0, {.min = 0.1, .max = 5}),
+        MS<Float>("input:touchpad:scroll_accel_max", "Maximum scroll acceleration multiplier.", 3.0, {.min = 1, .max = 10}),
+        MS<Float>("input:touchpad:scroll_decel", "Deceleration time (ms) for scroll inertia.", 150, {.min = 0, .max = 1000}),
         MS<Bool>("input:touchpad:middle_button_emulation", "Sending LMB and RMB simultaneously will be interpreted as a middle click.", false,
                  {.refresh = Supplementary::REFRESH_INPUT_DEVICES}),
         MS<String>("input:touchpad:tap_button_map", "Sets the tap button mapping for touchpad button emulation. [lrm/lmr]", STRVAL_EMPTY,
-- 
